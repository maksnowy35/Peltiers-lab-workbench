{
  // Python: the interpreter is the .venv in the repository root (created by `./dev.sh setup`).
  // VS Code offers it on first open; otherwise Ctrl+Shift+P -> "Python: Select Interpreter" -> .venv.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}/backend/src"],
  "python.terminal.activateEnvironment": true,

  // Ruff formats and sorts imports on save; it reads backend/pyproject.toml, ruff.toml or
  // tools/ansys/ruff.toml, whichever is closest to the file.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  // Frontend: TypeScript from the project, not the one bundled with VS Code (Angular 22 needs 6.0).
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.preferences.quoteStyle": "single",
  "files.eol": "\n",
  "editor.rulers": [120],

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "frontend/.angular": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "frontend/dist": true,
    ".venv": true
  },

  // Windows: integrated terminal and tasks use Git Bash, so every command of docs/development.md
  // works unchanged. Adjust the path if Git for Windows is installed elsewhere.
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.automationProfile.windows": {
    "path": "C:\\Program Files\\Git\\bin\\bash.exe"
  }
}
