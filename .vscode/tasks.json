{
  // Terminal > Run Task... (Ctrl+Shift+B runs the default build task). Every task calls dev.sh,
  // so tasks, the terminal and CI run the same commands.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: venv + dependencies",
      "type": "shell",
      "command": "./dev.sh setup",
      "problemMatcher": []
    },
    {
      "label": "backend: API (reload)",
      "type": "shell",
      "command": "./dev.sh api",
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^(ERROR):\\s+(.*)$", "severity": 1, "message": 2 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Will watch for changes|Started server process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "frontend: dev server",
      "type": "shell",
      "command": "./dev.sh ui",
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": { "regexp": "^\\s*(ERROR|✘ \\[ERROR\\])\\s+(.*)$", "severity": 1, "message": 2 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Building|Changes detected",
          "endsPattern": "Local:|bundle generation complete|Watch mode enabled"
        }
      }
    },
    {
      "label": "dev: API + UI",
      "dependsOn": ["backend: API (reload)", "frontend: dev server"],
      "problemMatcher": []
    },
    {
      "label": "test: backend",
      "type": "shell",
      "command": "./dev.sh test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test: end-to-end (app must be running)",
      "type": "shell",
      "command": "./dev.sh e2e",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "check: everything CI checks",
      "type": "shell",
      "command": "./dev.sh check",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint: fix + format",
      "type": "shell",
      "command": "./dev.sh fix",
      "problemMatcher": []
    },
    {
      "label": "contract: regenerate TypeScript models",
      "type": "shell",
      "command": "./dev.sh contract",
      "problemMatcher": []
    },
    {
      "label": "docker: compose up --build",
      "type": "shell",
      "command": "./dev.sh docker",
      "problemMatcher": []
    }
  ]
}
